# Normalize all text files to LF in the repo, but CRLF on checkout
* text eol=crlf

# Source and configuration files
*.css text eol=crlf
*.html text eol=crlf
*.js text eol=crlf
*.jsx text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.ts text eol=crlf
*.tsx text eol=crlf
*.xml text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf

# SVG files stay LF for stable XML and asset diffs
*.svg text eol=lf

# Shell scripts must use LF
*.sh text eol=lf

# Windows command scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files must not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary